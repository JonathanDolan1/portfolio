---
import { getCollection, render } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import MediaSlot from '../../components/MediaSlot.astro';
import { siteConfig } from '../../config';
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({ params: { slug: project.id }, props: { project } }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---
<BaseLayout>
  <SEO slot="head" title={`${data.title} — Case study`} description={data.summary} />
  <article class="case-study">
    <a href="/projects/" class="back-link">← All projects</a>
    <header class="case-study-header"><p class="eyebrow">{data.featured ? 'Featured · ' : ''}{data.kind} · {data.year}</p><h1>{data.title}</h1><p class="lead">{data.summary}</p><p class="evidence-note">{data.role}</p></header>
    <section class="case-study-section"><h2>What it is</h2><p>{data.overview}</p></section>
    <section class="case-study-section"><h2>Problem</h2><p>{data.problem}</p></section>
    <section class="case-study-section"><h2>Solution</h2><p>{data.solution}</p></section>
    <section class="case-study-section"><h2>Architecture</h2><MediaSlot path={data.architecture} alt={`${data.title} architecture diagram`} owner="CLAUDE" kind="Architecture diagram" {...siteConfig.architecture} /></section>
    <section class="case-study-section"><h2>Stack</h2><ul class="stack-tags">{data.stack.map(item => <li>{item}</li>)}</ul></section>
    <section class="case-study-section"><h2>What I learned</h2><p>{data.learnings}</p></section>
    <section class="case-study-section"><h2>Screenshots</h2><div class="screenshots">{data.screenshots.map(image => <MediaSlot path={image.path} alt={image.alt} owner="JONATHAN" kind="Screenshot" {...siteConfig.screenshots} />)}</div></section>
    <div class="prose"><Content /></div>
    <section class="case-study-section code-section"><h2>Code</h2>
      {data.codePending ? <><p>The source code is private. A sanitized showcase repository is in preparation; code walkthroughs are available on request.</p></> : <a href={data.codeUrl}>View {data.title} code on GitHub</a>}
    </section>
  </article>
</BaseLayout>
